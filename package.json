{
  "name": "chenzebang-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:3d": "vite --open \"/?web3d=1#projects\"",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-dev-shortcut.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "build": "tsc -b && vite build && mkdir -p dist/server && cp server/index.js dist/server/index.js",
    "build:github": "tsc -b && vite build --mode github",
    "preview": "vite preview",
    "marquee:hd": "node scripts/process-marquee-hd.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@svg-maps/china": "^2.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "framer-motion": "^12.41.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@mapbox/geojson-rewind": "^0.5.2",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
